[Unit]
Description=Ripple IPC dispatcher
After=local-fs.target

[Service]
Type=notify
ExecStart=/usr/bin/ripple --daemon --gid ripple --timeout 15s
ExecReload=/usr/bin/ripple reload
RuntimeDirectory=ripple
RuntimeDirectoryMode=0755
ConfigurationDirectory=ripple/handlers
ConfigurationDirectoryMode=0755
StateDirectory=ripple
StateDirectoryMode=0755
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
